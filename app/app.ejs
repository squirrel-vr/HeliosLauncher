<html lang="uk" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/redesign.css">
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/redesign.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
</head>
<body>
    <div id="appBackground" data-treatment="auth" aria-hidden="true">
        <img class="bg__image" alt="">
        <div class="bg__dim"><canvas data-blur="auth"></canvas></div>
        <div class="bg__pattern"></div>
        <div class="bg__news"><canvas data-blur="panel"></canvas></div>
    </div>
    <div id="main">
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('loginDiscord') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer" role="status" aria-label="<%= lang('app.title') %>">
        <div class="startup__pattern"></div>
        <img class="startup__logo" src="assets/images/ui/project-logo.svg" alt="">
    </div>
</body>
</html>
