<div id="loginContainer" style="display: none;">
    <%- include('authHeader') %>
    <div id="loginCancelContainer" style="display: none;">
        <button id="loginCancelButton" class="icon-btn cancel-btn" aria-label="<%- lang('login.loginCancelText') %>" title="<%- lang('login.loginCancelText') %>">
            <img src="assets/images/ui/cancel-icon.svg" alt="">
        </button>
    </div>
    <div class="auth-stage">
        <form id="loginForm">
            <p class="auth-text" id="loginSubheader"><%- lang('login.loginSubheader') %></p>
            <label for="loginUsername" class="visually-hidden"><%- lang('login.loginEmailPlaceholder') %></label>
            <input id="loginUsername" class="text-field" type="text" maxlength="16" autocomplete="off" spellcheck="false" placeholder="<%- lang('login.loginEmailPlaceholder') %>"/>
            <span class="form-error" id="loginEmailError" role="alert"><%- lang('login.loginEmailError') %></span>
            <button id="loginButton" class="frame-btn" type="submit" disabled><%- lang('login.loginButtonText') %></button>
        </form>
    </div>
    <script src="./assets/js/scripts/login.js"></script>
</div>
