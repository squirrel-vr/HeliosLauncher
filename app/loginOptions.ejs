<div id="loginOptionsContainer" style="display: none;">
    <%- include('authHeader') %>
    <div id="loginOptionCancelContainer" style="display: none;">
        <button id="loginOptionCancelButton" class="icon-btn cancel-btn" aria-label="<%- lang('loginOptions.cancelButton') %>" title="<%- lang('loginOptions.cancelButton') %>">
            <img src="assets/images/ui/cancel-icon.svg" alt="">
        </button>
    </div>
    <div class="auth-stage">
        <p class="auth-text"><%- lang('loginOptions.loginOptionsTitle') %></p>
        <button id="loginOptionMicrosoft" class="frame-btn auth-btn">
            <img class="auth-btn__icon" src="assets/images/ui/microsoft-icon.svg" alt="">
            <span><%- lang('loginOptions.loginWithMicrosoft') %></span>
        </button>
        <button id="loginOptionMojang" class="frame-btn auth-btn">
            <img class="auth-btn__icon" src="assets/images/ui/offline-account-icon.svg" alt="">
            <span><%- lang('loginOptions.loginWithMojang') %></span>
        </button>
    </div>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>
