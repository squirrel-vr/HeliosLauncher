<div id="loginDiscordContainer" style="display: none;">
    <%- include('authHeader') %>
    <div class="auth-stage">
        <p class="auth-text"><%- lang('discordLogin.title') %></p>
        <button id="discordLogin" class="frame-btn auth-btn">
            <img class="auth-btn__icon" src="assets/images/ui/discord-icon.svg" alt="">
            <span><%- lang('discordLogin.login') %></span>
        </button>
        <div id="loginDiscordError" class="form-error" role="alert"></div>
    </div>
    <script src="./assets/js/scripts/discordLogin.js"></script>
</div>
