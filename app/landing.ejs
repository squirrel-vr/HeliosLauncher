<div id="landingContainer" style="display: none;">
    <header id="upper" class="bkg-pattern">
        <div class="panel-glass"><canvas data-blur="panel-top" data-design-h="158"></canvas></div>
        <div id="image_seal_container" class="brand brand--main" aria-label="VR UKRAINE Minecraft SMP">
            <img class="brand__emblem" src="assets/images/ui/vruagalyna-icon.svg" alt="">
            <img class="brand__wordmark" src="assets/images/ui/project-logo-text.svg" alt="VR UKRAINE Minecraft SMP">
        </div>
        <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
        <a id="discordURL" class="icon-btn mediaURL" href="<%- lang('landing.mediaDiscordURL') %>" aria-label="<%- lang('landing.discordLinkLabel') %>" title="<%- lang('landing.discordLinkLabel') %>">
            <img src="assets/images/ui/discord-icon.svg" alt="">
        </a>
    </header>
    <footer id="lower">
        <div class="panel-glass"><canvas data-blur="panel-bottom" data-design-h="264"></canvas></div>
        <button id="server_selection_button" class="text-btn">
            <img src="assets/images/ui/list-icon.svg" alt="">
            <span id="server_selection_name"><%- lang('landing.launchButtonPlaceholder') %></span>
        </button>
        <div id="server_status_wrapper" class="server-status" data-state="unknown">
            <span class="server-status__label" id="landingPlayerLabel"><%- lang('landing.serverStatus') %></span>
            <span class="server-status__value" id="player_count"><%- lang('landing.serverStatusPlaceholder') %></span>
        </div>
        <div id="mojangStatusWrapper" hidden>
            <span id="mojang_status_icon">&#8226;</span>
            <div id="mojangStatusTooltip">
                <div id="mojangStatusTooltipTitle"><%- lang('landing.mojangStatusTooltipTitle') %></div>
                <div id="mojangStatusEssentialContainer"></div>
                <div id="mojangStatusNEContainer"><div id="mojangStatusNETitle"><%- lang('landing.mojangStatusNETitle') %></div></div>
                <div id="mojangStatusNonEssentialContainer"></div>
            </div>
        </div>
        <button id="avatarOverlay" class="text-btn" title="<%- lang('landing.usernameEditButton') %>">
            <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
        </button>
        <div id="avatarContainer" aria-hidden="true"></div>
        <div id="launch_content">
            <button id="launch_button" class="play-btn bkg-pattern" data-state="default">
                <span class="play-btn__label" id="launch_button_label"><%- lang('landing.launchButton') %></span>
            </button>
            <button id="settingsMediaButton" class="square-btn" aria-label="<%- lang('landing.settingsTooltip') %>" title="<%- lang('landing.settingsTooltip') %>">
                <img src="assets/images/ui/settings-icon.svg" alt="">
            </button>
        </div>
        <div id="launch_details" class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="progress__track"><div class="progress__fill" id="launch_progress"></div></div>
            <span class="progress__label" id="launch_progress_label">0%</span>
            <span class="visually-hidden" id="launch_details_text" aria-live="polite"><%- lang('landing.launchDetails') %></span>
        </div>
    </footer>
    <button id="newsButton" class="text-btn" aria-expanded="false" aria-controls="newsContainer">
        <div id="newsButtonAlert" style="display: none;"></div>
        <span class="news-toggle__icons">
            <img class="news-toggle__open" src="assets/images/ui/news-icon.svg" alt="">
            <img class="news-toggle__close" src="assets/images/ui/cancel-icon.svg" alt="">
        </span>
        <span class="news-toggle__labels">
            <span id="newsButtonText" class="news-toggle__open"><%- lang('landing.newsButton') %></span>
            <span class="news-toggle__close"><%- lang('landing.newsCloseButton') %></span>
        </span>
    </button>
    <div id="newsContainer">
        <div id="newsContent" article="-1" style="display: none;">
            <div id="newsStatusContainer">
                <div id="newsStatusContent">
                    <div id="newsTitleContainer">
                        <a id="newsArticleTitle" href="#">Lorem Ipsum</a>
                    </div>
                    <div id="newsMetaContainer">
                        <div id="newsArticleDateWrapper">
                            <span id="newsArticleDate">Mar 15, 44 BC, 9:14 AM</span>
                        </div>
                        <div id="newsArticleAuthorWrapper">
                            <span id="newsArticleAuthor">by Cicero</span>
                        </div>
                        <a href="#" id="newsArticleComments">0 Comments</a>
                    </div>
                </div>
                <div id="newsNavigationContainer">
                    <button id="newsNavigateLeft">
                        <svg id="newsNavigationLeftSVG" viewBox="0 0 24.87 13.97">
                            <defs>
                                <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: stroke var(--dur-base) var(--ease-out-soft);}</style>
                            </defs>
                            <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                        </svg>
                    </button>
                    <span id="newsNavigationStatus"><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                    <button id="newsNavigateRight">
                        <svg id="newsNavigationRightSVG" viewBox="0 0 24.87 13.97">
                            <defs>
                                <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: stroke var(--dur-base) var(--ease-out-soft);}</style>
                            </defs>
                            <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                        </svg>
                    </button>
                </div>
            </div>
            <div id="newsArticleContainer">
                <div id="newsArticleContent">
                    <div id="newsArticleContentScrollable">
                        <!-- Article Content -->
                    </div>
                </div>
            </div>
        </div>
        <div id="newsErrorContainer">
            <div id="newsErrorLoading">
                <span id="nELoadSpan" class="newsErrorContent"><%- lang('landing.newsErrorLoadSpan') %></span>
            </div>
            <div id="newsErrorFailed" style="display: none;">
                <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                <button id="newsErrorRetry"><%- lang('landing.newsErrorRetryButton') %></button>
            </div>
            <div id="newsErrorNone" style="display: none;">
                <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/landing.js"></script>
</div>